# --- Build Stage ---
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy module files and dependencies
COPY go.mod ./
RUN go mod download || true

# Copy server code
COPY server.go ./

# Explicitly build server.go
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o sigil-webhook server.go

# --- Runtime Stage ---
FROM alpine:latest
RUN apk --no-cache add ca-certificates

WORKDIR /root/
COPY --from=builder /app/sigil-webhook .

EXPOSE 8080
CMD ["./sigil-webhook"]